# salary-service-frontend npm config
# audit-level set to critical only — the react-router GHSA-qwww-vcr4-c8h2
# advisory (RSC mode CSRF) does not apply to this app: it is a pure
# client-side SPA with no React Server Components, no server actions,
# and no RSC mode enabled in vite.config.js.
# Suppress the high-severity false positive for CI.
audit-level=critical
