# salary-service environment variables
# Copy to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# All required vars are validated at boot in utils/envValidator.js.
# If any required var is missing the process will REFUSE to start.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3012
TZ=Asia/Kolkata

# ─── Database ─────────────────────────────────────────────────────────────────
# Same Atlas cluster as AMS is fine, but a DIFFERENT database name.
# Do not point this at the AMS database.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/salary-service-db?retryWrites=true&w=majority

# ─── JWT (HS256 — this service is both issuer and sole verifier) ──────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# If this var is missing at boot the process will throw and exit — NO fallback.
JWT_SECRET=REPLACE_WITH_128_CHAR_HEX_SECRET

# Access token TTL (default: 15m)
JWT_EXPIRES_IN=15m

# Refresh token TTL in milliseconds (default: 7 days)
REFRESH_TOKEN_TTL_MS=604800000

# ─── Service-to-service token (salary-service → AMS internal feed) ────────────
# Long random secret shared only with AMS backend env.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SERVICE_TOKEN=REPLACE_WITH_96_CHAR_HEX_TOKEN

# AMS internal feed base URL (never the public-facing AMS subdomain for this)
AMS_INTERNAL_BASE_URL=http://localhost:3011

# ─── Encryption (EmployeeFinancialProfile sensitive fields) ───────────────────
# 32 bytes → 64 hex chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MISSING = process exits. NO fallback allowed.
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

# ─── Backblaze B2 (isolated payroll bucket) ───────────────────────────────────
# Create a separate B2 application key scoped ONLY to the payroll bucket.
# Do NOT reuse the AMS B2 key — separate credential, separate blast radius.
B2_KEY_ID=your_payroll_b2_key_id
B2_APPLICATION_KEY=your_payroll_b2_application_key
B2_BUCKET_NAME=byline-payroll-docs
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Default prefix for all objects in this service (trailing slash included)
B2_PREFIX=payroll/

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=https://payroll.bylinelms.com

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Optional: Month-end auto-generation ──────────────────────────────────────
# Set MONTH_END_AUTO_GENERATE_ENABLED=false to disable the in-process scheduler
# entirely (e.g. on staging or CI environments where you do not want cron fires).
# Omitting this variable is equivalent to 'true' — scheduler is ON by default.
#
# MONTH_END_AUTO_GENERATE_ENABLED=true

# Standard cron expression for when the month-end job fires.
# Default: 03:00 Asia/Kolkata on the 1st of every month ('0 3 1 * *').
# The scheduler uses the TZ variable above for timezone evaluation.
# Missed fires (e.g. process was down at the scheduled time) can be recovered via:
#   POST /api/payroll-runs/auto-generate/trigger  (Admin only)
#
# MONTH_END_CRON_SCHEDULE=0 3 1 * *
